// PSk-Personal-POS — Prisma schema
// Modeled from project sketch notes: Inventory, Product, Purchase/Sales/Transfer/Stock-Adjustment,
// Supplier, Sales Contracts / AR, and Engineer Service modules.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

enum ProductType {
  PRODUCT
  SERVICE
}

enum UnitKind {
  BASE
  PURCHASE
  SELLING
}

enum StockMovementType {
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum SalesContractStatus {
  DRAFT
  ACTIVE
  FULFILLED
  CANCELLED
}

enum PurchaseOrderStatus {
  ORDERED // saved, goods not yet received, no stock effect
  PARTIALLY_RECEIVED // some lines/quantities received
  RECEIVED // fully received, all lines complete
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum ServiceTicketStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Inventory module: Main Category -> Sub Category, Brand, Unit
// ---------------------------------------------------------------------------

model MainCategory {
  id            String        @id @default(cuid())
  name          String        @unique
  type          ProductType   @default(PRODUCT) // Product vs Service, per sketch
  subCategories SubCategory[]
  products      Product[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SubCategory {
  id             String       @id @default(cuid())
  name           String
  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id])
  mainCategoryId String
  products       Product[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([mainCategoryId, name])
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// A unit "family" groups a base unit with its purchase/selling conversions,
// e.g. base = pcs, purchase = carton (x24), selling = pcs.
model Unit {
  id            String    @id @default(cuid())
  name          String    @unique // e.g. "pcs", "box", "carton"
  kind          UnitKind  @default(BASE)
  baseUnit      Unit?     @relation("UnitConversion", fields: [baseUnitId], references: [id])
  baseUnitId    String?
  derivedUnits  Unit[]    @relation("UnitConversion")
  conversionQty Float     @default(1) // how many base units per this unit
  products      Product[] @relation("ProductBaseUnit")

  // Places this unit was used as the "entered" unit on a transaction line
  // (e.g. someone bought/sold/adjusted stock in "box" while base unit is "pcs").
  purchaseLineEntries  PurchaseOrderLine[] @relation("PurchaseLineEntryUnit")
  salesLineEntries     SalesOrderLine[]    @relation("SalesLineEntryUnit")
  stockMovementEntries StockMovement[]     @relation("StockMovementEntryUnit")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Currency & Price Groups
// ---------------------------------------------------------------------------

model Currency {
  id           String          @id @default(cuid())
  code         String          @unique // "MMK", "USD"
  name         String
  isDefault    Boolean         @default(false)
  exchangeRate Float           @default(1) // relative to default currency
  prices       ProductPrice[]
  purchases    PurchaseOrder[]
  sales        SalesOrder[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model PriceGroup {
  id        String         @id @default(cuid())
  name      String         @unique // e.g. "Retail", "Wholesale", "VIP"
  isDefault Boolean        @default(false)
  prices    ProductPrice[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// ---------------------------------------------------------------------------
// Product & related lookups
// ---------------------------------------------------------------------------

model Product {
  id         String      @id @default(cuid())
  name       String
  code       String      @unique
  codeIsAuto Boolean     @default(true) // whether `code` was system-generated vs typed in
  type       ProductType @default(PRODUCT)

  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id])
  mainCategoryId String
  subCategory    SubCategory? @relation(fields: [subCategoryId], references: [id])
  subCategoryId  String?
  brand          Brand?       @relation(fields: [brandId], references: [id])
  brandId        String?

  baseUnit   Unit   @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])
  baseUnitId String

  // One barcode per product; source records whether it's the manufacturer's
  // original barcode or one generated by the system.
  barcode       String        @unique
  barcodeSource BarcodeSource @default(SYSTEM)

  // Latest/default purchasing price + preferred supplier, per sketch
  // (actual purchase history lives on PurchaseOrderLine).
  defaultPurchasePrice Float?
  defaultSupplier      Supplier? @relation(fields: [defaultSupplierId], references: [id])
  defaultSupplierId    String?

  prices         ProductPrice[]
  documents      ProductDocument[]
  purchaseLines  PurchaseOrderLine[]
  salesLines     SalesOrderLine[]
  stockMovements StockMovement[]
  stockBatches   StockBatch[]
  contractLines  SalesContractLine[]

  generalData Json? // free-form spec sheet fields (key/value pairs)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum BarcodeSource {
  ORIGINAL // manufacturer barcode, scanned as-is
  SYSTEM // generated by the system (sequential or random)
}

// Selling price per price-group / currency (e.g. Retail/MMK, Wholesale/USD).
model ProductPrice {
  id           String     @id @default(cuid())
  product      Product    @relation(fields: [productId], references: [id])
  productId    String
  priceGroup   PriceGroup @relation(fields: [priceGroupId], references: [id])
  priceGroupId String
  currency     Currency   @relation(fields: [currencyId], references: [id])
  currencyId   String
  price        Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([productId, priceGroupId, currencyId])
}

// Attachments per product: FDA/NHL certificates and other compliance documents.
model ProductDocument {
  id        String    @id @default(cuid())
  product   Product   @relation(fields: [productId], references: [id])
  productId String
  label     String // e.g. "FDA Certificate", "NHL Certificate"
  fileUrl   String
  issuedAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Supplier & Purchasing
// ---------------------------------------------------------------------------

model Supplier {
  id                 String          @id @default(cuid())
  name               String          @unique
  contact            String?
  address            String?
  purchases          PurchaseOrder[]
  defaultForProducts Product[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  reference       String              @unique
  referenceIsAuto Boolean             @default(true) // whether `reference` was system-generated vs typed in
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  supplierId      String
  currency        Currency            @relation(fields: [currencyId], references: [id])
  currencyId      String
  warehouse       Warehouse           @relation(fields: [warehouseId], references: [id])
  warehouseId     String
  lines           PurchaseOrderLine[]

  status PurchaseOrderStatus @default(ORDERED)

  // Payment tracking (kept here for now; may move to a dedicated Accounts module later).
  paymentStatus PaymentStatus @default(UNPAID)
  amountPaid    Float         @default(0)

  note       String?
  orderedAt  DateTime  @default(now())
  receivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String
  product         Product       @relation(fields: [productId], references: [id])
  productId       String

  // What the user actually typed in, e.g. "24" boxes.
  entryQuantity Float
  entryUnit     Unit   @relation("PurchaseLineEntryUnit", fields: [entryUnitId], references: [id])
  entryUnitId   String

  // entryQuantity converted to the product's smallest base unit for stock-keeping,
  // e.g. 24 boxes x 10 bottles/box = 240 (stored here, in bottles).
  quantity Float

  // How many base units of this line have been received so far (supports
  // partial receiving across multiple "Receive" actions).
  receivedQuantity Float @default(0)

  unitCost Float // purchase cost per entry unit, per sketch

  batches StockBatch[]
}

// A specific lot/batch of stock, created when a Purchase Order line is
// (fully or partially) received into a Warehouse. Tracks received date and
// an optional expiry date, and keeps a running remaining quantity so a
// future Sales module can deduct from batches (e.g. FIFO / expiry-aware).
model StockBatch {
  id          String @id @default(cuid())
  batchNumber String @unique // auto-generated, e.g. BATCH-20260911-001

  product   Product @relation(fields: [productId], references: [id])
  productId String

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  warehouseId String

  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  purchaseOrderLineId String?

  quantityReceived  Float // base units received into this batch
  quantityRemaining Float // base units still on hand from this batch
  unitCost          Float // cost per base unit (unitCost on the line, divided by its entry unit's conversion qty)

  receivedAt DateTime  @default(now())
  expiryDate DateTime?

  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Sales (POS) module
// ---------------------------------------------------------------------------

model Customer {
  id             String          @id @default(cuid())
  name           String
  contact        String?
  address        String?
  sales          SalesOrder[]
  contracts      SalesContract[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  serviceTickets ServiceTicket[]
}

model SalesOrder {
  id         String           @id @default(cuid())
  reference  String           @unique
  customer   Customer?        @relation(fields: [customerId], references: [id])
  customerId String?
  currency   Currency         @relation(fields: [currencyId], references: [id])
  currencyId String
  lines      SalesOrderLine[]
  soldAt     DateTime         @default(now())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model SalesOrderLine {
  id           String     @id @default(cuid())
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  salesOrderId String
  product      Product    @relation(fields: [productId], references: [id])
  productId    String

  // What the user actually typed in, e.g. "2" boxes at checkout.
  entryQuantity Float
  entryUnit     Unit   @relation("SalesLineEntryUnit", fields: [entryUnitId], references: [id])
  entryUnitId   String

  // entryQuantity converted to the product's smallest base unit, for stock deduction.
  quantity  Float
  unitPrice Float // selling price per entry unit
}

// ---------------------------------------------------------------------------
// Transfer & Stock Adjustment (feed into a single Inventory ledger)
// ---------------------------------------------------------------------------

model Warehouse {
  id             String          @id @default(cuid())
  name           String          @unique
  address        String?
  movements      StockMovement[]
  batches        StockBatch[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// Unified ledger: purchase / sale / transfer / adjustment all write here.
// `quantity` is always expressed in the product's smallest base unit, so
// on-hand stock can be summed directly regardless of which unit a
// purchase/sale/adjustment was originally entered in.
model StockMovement {
  id          String            @id @default(cuid())
  product     Product           @relation(fields: [productId], references: [id])
  productId   String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  warehouseId String
  type        StockMovementType
  quantity    Float // in base units; positive = in, negative = out (keep sign consistent per type)

  // Optional: preserves what was actually typed (e.g. "5 cartons") for display/audit,
  // even though `quantity` above is already converted to base units.
  entryQuantity Float?
  entryUnit     Unit?   @relation("StockMovementEntryUnit", fields: [entryUnitId], references: [id])
  entryUnitId   String?

  batch   StockBatch? @relation(fields: [batchId], references: [id])
  batchId String?

  reference String? // links back to PurchaseOrder / SalesOrder / Transfer / Adjustment id
  note      String?
  createdAt DateTime @default(now())
}

model StockTransfer {
  id            String   @id @default(cuid())
  reference     String   @unique
  fromWarehouse String
  toWarehouse   String
  note          String?
  createdAt     DateTime @default(now())
}

model StockAdjustment {
  id        String   @id @default(cuid())
  reference String   @unique
  reason    String
  note      String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Sales Contracts / A-R (accounts receivable) module
// ---------------------------------------------------------------------------

model SalesContract {
  id         String              @id @default(cuid())
  reference  String              @unique
  customer   Customer            @relation(fields: [customerId], references: [id])
  customerId String
  status     SalesContractStatus @default(DRAFT)
  lines      SalesContractLine[]
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model SalesContractLine {
  id              String        @id @default(cuid())
  contract        SalesContract @relation(fields: [contractId], references: [id])
  contractId      String
  product         Product       @relation(fields: [productId], references: [id])
  productId       String
  quantity        Float
  agreedUnitPrice Float
}

// ---------------------------------------------------------------------------
// Engineer Service module
// ---------------------------------------------------------------------------

model ServiceTicket {
  id          String              @id @default(cuid())
  reference   String              @unique
  customer    Customer?           @relation(fields: [customerId], references: [id])
  customerId  String?
  title       String
  description String?
  status      ServiceTicketStatus @default(OPEN)
  assignedTo  String? // engineer name/id, kept simple until a Staff model is needed
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}
